{
  "info": {
    "name": "scenic-dh API",
    "description": "Local smoke collection for business-api and admin-api.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "business", "value": "http://localhost:8001" },
    { "key": "admin", "value": "http://localhost:8002" },
    { "key": "admin_user", "value": "admin" },
    { "key": "admin_password", "value": "" },
    { "key": "admin_token", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "business-api health",
          "request": { "method": "GET", "url": { "raw": "{{business}}/health" } }
        },
        {
          "name": "admin-api health",
          "request": { "method": "GET", "url": { "raw": "{{admin}}/health" } }
        }
      ]
    },
    {
      "name": "Business",
      "item": [
        {
          "name": "spots",
          "request": { "method": "GET", "url": { "raw": "{{business}}/v1/spots" } }
        },
        {
          "name": "routes",
          "request": { "method": "GET", "url": { "raw": "{{business}}/v1/routes" } }
        },
        {
          "name": "create session",
          "request": {
            "method": "POST",
            "url": { "raw": "{{business}}/v1/sessions" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"source\":\"postman\",\"language\":\"zh\"}" }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.data && data.data.token) pm.collectionVariables.set('admin_token', data.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{admin}}/v1/auth/login" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"username\":\"{{admin_user}}\",\"password\":\"{{admin_password}}\"}" }
          }
        },
        {
          "name": "me",
          "request": {
            "method": "GET",
            "url": { "raw": "{{admin}}/v1/auth/me" },
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }]
          }
        },
        {
          "name": "knowledge status",
          "request": {
            "method": "GET",
            "url": { "raw": "{{admin}}/v1/knowledge/status" },
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }]
          }
        },
        {
          "name": "runtime status",
          "request": {
            "method": "GET",
            "url": { "raw": "{{admin}}/v1/runtime/status" },
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }]
          }
        }
      ]
    }
  ]
}
