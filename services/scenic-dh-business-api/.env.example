# scenic-dh-business-api 配置
# 复制此文件为 .env 并填写真实值

# 数据库
DATABASE_URL=sqlite:///./scenic_business.db

# 上游服务
RAG_SERVICE_URL=http://localhost:8003/api/v1
AVATAR_ORCHESTRATOR_URL=http://localhost:8004/v1

# 内部服务 token
SERVICE_TOKEN=svc-dev-token

# 和风天气 API key（注册免费: https://dev.qweather.com）
# 空值时自动降级为 mock 数据
QWEATHER_API_KEY=
