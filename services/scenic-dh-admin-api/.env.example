# Copy to .env and adjust for your environment.

DATABASE_URL=sqlite:///../scenic-dh-business-api/scenic_business.db
BUSINESS_API_URL=http://localhost:8001/v1
RAG_SERVICE_URL=http://127.0.0.1:5010/api/v1
RAG_API_KEY=replace-with-rag-token

FAY_HTTP_URL=http://127.0.0.1:5000
FAY_CORE_URL=http://127.0.0.1:5000
FAY_MCP_URL=http://127.0.0.1:5010
FAY_WS_URL=ws://127.0.0.1:10000

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Legacy fixed-token auth is local-only and disabled by default.
ALLOW_LEGACY_ADMIN_TOKEN=false
ADMIN_TOKEN=
JWT_EXPIRE_HOURS=8
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=replace-before-first-start
ADMIN_BOOTSTRAP_DISPLAY_NAME=系统管理员

INTERNAL_SERVICE_TOKEN=replace-with-random-token
LOG_LEVEL=INFO
