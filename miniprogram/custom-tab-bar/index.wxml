<view class="custom-tabbar safe-bottom" aria-label="游客端主导航">
  <button wx:for="{{items}}" wx:key="pagePath" class="tab-item {{selected === index ? 'active' : ''}} {{item.danger ? 'danger' : ''}}" bindtap="switchTab" data-path="{{item.pagePath}}" data-index="{{index}}" hover-class="tab-press">
    <view class="tab-indicator"></view>
    <text class="tab-label">{{item.text}}</text>
  </button>
</view>
