<view class="custom-tabbar safe-bottom"><button wx:for="{{items}}" wx:key="pagePath" class="tab-item {{selected === index ? 'active' : ''}} {{item.danger ? 'danger' : ''}}" bindtap="switchTab" data-path="{{item.pagePath}}" data-index="{{index}}" hover-class="tab-press"><view class="tab-glyph">{{item.glyph}}</view><text>{{item.text}}</text></button></view>