.custom-tabbar{position:fixed;z-index:90;display:flex;left:20rpx;right:20rpx;bottom:16rpx;min-height:104rpx;padding:8rpx 10rpx calc(8rpx + env(safe-area-inset-bottom));border:1rpx solid rgba(29,86,76,.12);border-radius:32rpx;background:rgba(255,255,255,.98);box-shadow:0 22rpx 56rpx rgba(15,67,58,.17)}
.tab-item{position:relative;display:flex;min-width:0;min-height:76rpx;margin:0 3rpx;padding:12rpx 2rpx 8rpx;flex:1;align-items:center;justify-content:center;border:0;border-radius:22rpx;color:#6f817c;background:transparent;font-size:23rpx;font-weight:780}
.tab-item.active{color:var(--green-deep);background:var(--green-soft)}
.tab-item.danger{color:var(--danger)}
.tab-item.danger.active{color:#fff;background:linear-gradient(145deg,var(--danger),#9d332e)}
.tab-indicator{position:absolute;top:7rpx;left:50%;width:24rpx;height:5rpx;border-radius:999rpx;background:transparent;transform:translateX(-50%)}
.tab-item.active .tab-indicator{background:currentColor}
.tab-label{max-width:100%;overflow:hidden;line-height:1.2;text-overflow:ellipsis;white-space:nowrap}
.tab-press{transform:scale(.97);opacity:.86}
