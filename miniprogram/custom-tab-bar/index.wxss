.custom-tabbar{position:fixed;z-index:90;display:flex;left:20rpx;right:20rpx;bottom:18rpx;min-height:112rpx;padding:12rpx 8rpx calc(12rpx + env(safe-area-inset-bottom));border:1rpx solid rgba(29,86,76,.12);border-radius:34rpx;background:rgba(255,255,255,.97);box-shadow:0 24rpx 60rpx rgba(15,67,58,.18)}.tab-item{display:flex;min-width:0;min-height:76rpx;margin:0 2rpx;padding:6rpx 2rpx;flex:1;flex-direction:column;align-items:center;justify-content:center;border:0;border-radius:22rpx;color:#758782;background:transparent;font-size:19rpx;font-weight:750}.tab-item.active{color:var(--green-deep);background:var(--green-soft)}.tab-item.danger{color:var(--danger)}.tab-item.danger.active{color:#fff;background:linear-gradient(145deg,var(--danger),#9d332e)}.tab-glyph{display:flex;align-items:center;justify-content:center;width:36rpx;height:36rpx;margin-bottom:4rpx;border-radius:12rpx;font-size:18rpx;font-weight:900}.tab-item.active .tab-glyph{background:rgba(255,255,255,.62)}.tab-item.danger.active .tab-glyph{background:rgba(255,255,255,.16)}.tab-press{transform:scale(.95);opacity:.88}.tab-item.active .tab-glyph{animation:tabPop 220ms cubic-bezier(.2,.8,.2,1)}@keyframes tabPop{0%{transform:scale(.82);opacity:.55}70%{transform:scale(1.08);opacity:1}100%{transform:scale(1)}}