<view class="lbs-card {{online ? '' : 'offline'}}">
  <view class="lbs-pin" aria-hidden="true">
    <view class="pin-core"></view>
  </view>
  <view class="lbs-copy">
    <text class="lbs-overline">LBS · {{online ? lbsActiveLabel : offlineModeLabel}}</text>
    <text class="lbs-spot">{{spotName}}</text>
  </view>
  <view class="lbs-distance">
    <text class="distance-value">{{distance}}</text>
    <text class="distance-unit">m</text>
    <view class="signal-dot {{online ? '' : 'offline'}}"></view>
  </view>
</view>
