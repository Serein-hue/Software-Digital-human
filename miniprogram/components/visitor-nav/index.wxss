.visitor-nav { position:fixed; z-index:80; display:flex; left:20rpx; right:20rpx; bottom:18rpx; min-height:112rpx; padding:12rpx 10rpx calc(12rpx + env(safe-area-inset-bottom)); border:1rpx solid rgba(29,86,76,.12); border-radius:34rpx; background:rgba(255,255,255,.96); box-shadow:0 24rpx 60rpx rgba(15,67,58,.18); backdrop-filter:blur(24rpx); }
.visitor-nav-item { display:flex; min-width:0; min-height:76rpx; margin:0 3rpx; padding:7rpx 4rpx; flex:1; flex-direction:column; align-items:center; justify-content:center; border:0; border-radius:24rpx; color:#758782; background:transparent; font-size:20rpx; font-weight:750; }
.visitor-nav-item.active { color:var(--green-deep); background:var(--green-soft); }
.visitor-nav-item.danger { color:var(--danger); }
.visitor-nav-item.danger.active { color:#fff; background:linear-gradient(145deg,var(--danger),#9d332e); }
.visitor-nav-glyph { display:flex; align-items:center; justify-content:center; width:38rpx; height:38rpx; margin-bottom:4rpx; border-radius:13rpx; font-size:19rpx; font-weight:900; }
.visitor-nav-item.active .visitor-nav-glyph { background:rgba(255,255,255,.62); }
.visitor-nav-item.danger.active .visitor-nav-glyph { background:rgba(255,255,255,.16); }
.visitor-nav-label { max-width:112rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.visitor-nav-press { transform:scale(.95); opacity:.88; }
