.visitor-nav{position:fixed;z-index:80;display:flex;left:20rpx;right:20rpx;bottom:16rpx;min-height:104rpx;padding:8rpx 10rpx calc(8rpx + env(safe-area-inset-bottom));border:1rpx solid rgba(29,86,76,.12);border-radius:32rpx;background:rgba(255,255,255,.98);box-shadow:0 22rpx 56rpx rgba(15,67,58,.17)}
.visitor-nav-item{position:relative;display:flex;min-width:0;min-height:76rpx;margin:0 3rpx;padding:12rpx 2rpx 8rpx;flex:1;align-items:center;justify-content:center;border:0;border-radius:22rpx;color:#6f817c;background:transparent;font-size:23rpx;font-weight:780}
.visitor-nav-item.active{color:var(--green-deep);background:var(--green-soft)}
.visitor-nav-item.danger{color:var(--danger)}
.visitor-nav-item.danger.active{color:#fff;background:linear-gradient(145deg,var(--danger),#9d332e)}
.visitor-nav-indicator{position:absolute;top:7rpx;left:50%;width:24rpx;height:5rpx;border-radius:999rpx;background:transparent;transform:translateX(-50%)}
.visitor-nav-item.active .visitor-nav-indicator{background:currentColor}
.visitor-nav-label{max-width:100%;overflow:hidden;line-height:1.2;text-overflow:ellipsis;white-space:nowrap}
.visitor-nav-press{transform:scale(.97);opacity:.86}
