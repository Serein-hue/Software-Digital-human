.emergency-page{min-height:100vh;padding-bottom:calc(48rpx + env(safe-area-inset-bottom));}.header{background:transparent;border:0;}.safety-hero{display:flex;align-items:center;min-height:220rpx;margin:8rpx 24rpx 22rpx;padding:30rpx;border-radius:40rpx;color:#fff;background:linear-gradient(140deg,#7d2f2b,#b4463e 58%,#d46452);box-shadow:0 24rpx 58rpx rgba(180,70,62,.24);}.safety-glyph{display:flex;align-items:center;justify-content:center;width:126rpx;height:126rpx;margin-right:25rpx;flex-shrink:0;border:1rpx solid rgba(255,255,255,.2);border-radius:42rpx;background:rgba(255,255,255,.11);font-size:31rpx;font-weight:950;letter-spacing:2rpx;}.safety-copy{display:flex;min-width:0;flex:1;flex-direction:column;}.safety-eyebrow{color:#ffd5cf;font-size:18rpx;font-weight:850;letter-spacing:2rpx;}.safety-title{margin-top:10rpx;font-size:36rpx;font-weight:900;line-height:1.25;}.safety-tip{margin-top:11rpx;color:rgba(255,255,255,.76);font-size:21rpx;line-height:1.5;}.emergency-form,.sent-box{padding:0 24rpx;}.type-row{display:flex;justify-content:space-between;margin-bottom:18rpx;}.type-btn{display:flex;width:31.7%;min-height:116rpx;margin:0;padding:13rpx 8rpx;flex-direction:column;align-items:center;justify-content:center;border:1rpx solid var(--line);border-radius:28rpx;color:var(--muted);background:rgba(255,255,255,.92);font-size:22rpx;font-weight:800;}.type-btn.active{color:var(--danger);border-color:rgba(196,70,61,.35);background:var(--danger-soft);box-shadow:0 13rpx 28rpx rgba(196,70,61,.1);}.type-glyph{display:flex;align-items:center;justify-content:center;width:48rpx;height:48rpx;margin-bottom:8rpx;border-radius:16rpx;color:#fff;background:#8a9b96;font-size:20rpx;font-weight:900;}.type-btn.active .type-glyph{background:var(--danger);}.location-card,.field-card{display:flex;margin-bottom:16rpx;border:1rpx solid var(--line);border-radius:30rpx;background:rgba(255,255,255,.93);box-shadow:0 14rpx 36rpx rgba(20,72,63,.055);}.location-card{align-items:center;min-height:104rpx;padding:18rpx 21rpx;}.location-pin{position:relative;width:42rpx;height:51rpx;margin:0 19rpx 0 8rpx;border:6rpx solid var(--green);border-radius:50% 50% 50% 0;transform:rotate(-45deg);}.location-pin view{position:absolute;width:10rpx;height:10rpx;top:13rpx;left:11rpx;border-radius:50%;background:var(--green);}.location-copy{display:flex;min-width:0;flex:1;flex-direction:column;}.field-label{color:var(--green);font-size:19rpx;font-weight:800;letter-spacing:1rpx;}.location-value{margin-top:6rpx;overflow:hidden;font-size:24rpx;font-weight:800;text-overflow:ellipsis;white-space:nowrap;}.live-dot{width:12rpx;height:12rpx;margin-left:14rpx;border-radius:50%;background:#35ad84;box-shadow:0 0 0 7rpx var(--green-soft);}.field-card{padding:20rpx 22rpx;flex-direction:column;}.desc-input{width:100%;height:190rpx;margin-top:12rpx;padding:15rpx 16rpx;border:1rpx solid var(--line);border-radius:22rpx;color:var(--ink);background:var(--paper-light);font-size:25rpx;line-height:1.6;}.contact-input{height:76rpx;margin-top:10rpx;padding:0 16rpx;border:1rpx solid var(--line);border-radius:22rpx;background:var(--paper-light);font-size:25rpx;}.submit-btn{display:flex;align-items:center;justify-content:center;min-height:96rpx;margin:22rpx 0 14rpx;border:0;border-radius:30rpx;color:#fff;background:linear-gradient(135deg,var(--danger),#9d332e);box-shadow:0 20rpx 40rpx rgba(196,70,61,.22);font-size:29rpx;font-weight:900;}.submit-mark{display:flex;align-items:center;justify-content:center;width:42rpx;height:42rpx;margin-right:12rpx;border:2rpx solid rgba(255,255,255,.7);border-radius:50%;font-size:24rpx;}.submit-press{transform:scale(.98);opacity:.92;}.hotline-btn{display:flex;align-items:center;justify-content:space-between;min-height:82rpx;margin:0;padding:0 22rpx;border:1rpx solid rgba(196,70,61,.22);border-radius:26rpx;color:var(--danger);background:var(--danger-soft);font-size:23rpx;font-weight:800;}.hotline-number{font-size:25rpx;font-weight:900;letter-spacing:1rpx;}.sent-box{display:flex;flex-direction:column;align-items:center;text-align:center;}.sent-check{display:flex;align-items:center;justify-content:center;width:118rpx;height:118rpx;margin:42rpx 0 24rpx;border-radius:39rpx;color:#fff;background:linear-gradient(145deg,#36ad84,#16866f);box-shadow:0 20rpx 42rpx rgba(22,134,111,.22);font-size:54rpx;font-weight:800;}.sent-title{font-size:36rpx;font-weight:900;}.sent-msg{max-width:620rpx;margin-top:14rpx;color:var(--muted);font-size:24rpx;line-height:1.7;}.sent-id{display:flex;width:100%;margin:23rpx 0;padding:18rpx 21rpx;justify-content:space-between;border:1rpx solid var(--line);border-radius:24rpx;background:#fff;color:var(--muted);font-size:21rpx;}.sent-id text:last-child{color:var(--ink);font-weight:800;}.reset-btn{width:100%;margin:0 0 14rpx;}.spacer{width:72rpx;}
