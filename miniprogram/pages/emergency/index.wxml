<view class="emergency-page page has-visitor-nav">
  <view class="header motion-rise"><view class="spacer"></view><text class="title">{{title}}</text><view class="spacer"></view></view>
  <view class="safety-hero motion-rise-2"><view class="safety-glyph">求助</view><view class="safety-copy"><text class="safety-eyebrow">{{safetyEyebrow}}</text><text class="safety-title">{{safetyTitle}}</text><text class="safety-tip">{{directCallLabel}}</text></view></view>
  <view wx:if="{{!sent}}" class="emergency-form motion-rise-3">
    <view class="type-row"><button wx:for="{{types}}" wx:key="key" class="type-btn {{activeType === item.key ? 'active' : ''}}" bindtap="onTypeTap" data-type="{{item.key}}"><text class="type-glyph">{{item.glyph}}</text><text>{{item.label}}</text></button></view>
    <view class="location-card"><view class="location-pin"><view></view></view><view class="location-copy"><text class="field-label">{{locationLabel}}</text><text class="location-value">{{location}}</text></view><view class="live-dot"></view></view>
    <view class="field-card"><text class="field-label">{{descPlaceholder}}</text><textarea class="desc-input" placeholder="{{descPlaceholder}}" value="{{desc}}" bindinput="onDescInput" maxlength="500"></textarea></view>
    <view class="field-card"><text class="field-label">{{contactPlaceholder}}</text><input class="contact-input" placeholder="{{contactPlaceholder}}" value="{{contact}}" bindinput="onContactInput" type="number" maxlength="11" /></view>
    <button class="submit-btn" bindtap="onSubmit" loading="{{submitting}}" hover-class="submit-press"><text class="submit-mark">!</text><text>{{submitLabel}}</text></button>
    <button class="hotline-btn" bindtap="callScenic"><text>{{callScenicLabel}}</text><text class="hotline-number">0510-85681234</text></button>
  </view>
  <view wx:else class="sent-box motion-rise-2"><view class="sent-check">✓</view><text class="sent-title">{{sentLabel}}</text><text class="sent-msg">{{resultMsg}}</text><view wx:if="{{resultId}}" class="sent-id"><text>{{caseIdLabel}}</text><text>{{resultId}}</text></view><button class="reset-btn btn-primary" bindtap="onReset">{{newRequestLabel}}</button><button class="hotline-btn" bindtap="callScenic"><text>{{callScenicLabel}}</text><text class="hotline-number">0510-85681234</text></button></view>
</view>