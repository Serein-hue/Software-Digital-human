
.guide-page {
  min-height: 100vh;
  padding: calc(env(safe-area-inset-top) + 22rpx) 24rpx calc(190rpx + env(safe-area-inset-bottom));
  overflow: hidden;
}

.ambient-orb, .ambient-dot { position: absolute; pointer-events: none; }
.ambient-orb { border-radius: 50%; filter: blur(2rpx); opacity: .72; }
.orb-a { width: 330rpx; height: 330rpx; top: 120rpx; right: -160rpx; background: rgba(72, 167, 140, .14); animation: floatY 7s ease-in-out infinite; }
.orb-b { width: 260rpx; height: 260rpx; top: 770rpx; left: -150rpx; background: rgba(59, 130, 185, .1); animation: floatY 9s ease-in-out 1s infinite; }
.ambient-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--amber); opacity: .55; }
.dot-a { top: 220rpx; left: 46rpx; }
.dot-b { top: 690rpx; right: 48rpx; }

.guide-header { position: relative; z-index: 5; display: flex; align-items: center; justify-content: space-between; min-height: 78rpx; margin-bottom: 22rpx; }
.brand-lockup { display: flex; align-items: center; min-width: 0; }
.brand-mark { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; margin-right: 16rpx; border-radius: 25rpx; color: #fff; background: linear-gradient(145deg, var(--green), var(--green-deep)); box-shadow: 0 14rpx 30rpx rgba(13,85,73,.2); font-size: 30rpx; font-weight: 900; }
.brand-copy { display: flex; flex-direction: column; min-width: 0; }
.brand-overline { color: var(--green); font-size: 19rpx; font-weight: 800; letter-spacing: 3rpx; }
.guide-title { max-width: 300rpx; margin-top: 4rpx; overflow: hidden; color: var(--ink); font-size: 32rpx; font-weight: 900; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
.guide-header-actions { display: flex; align-items: center; margin-left: 12rpx; }
.guide-header-btn { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; margin: 0 0 0 8rpx; padding: 0; border: 1rpx solid var(--line); border-radius: 22rpx; color: var(--green-deep); background: rgba(255,255,255,.84); box-shadow: 0 10rpx 24rpx rgba(20,72,63,.06); font-size: 25rpx; font-weight: 800; }
.guide-header-btn.lang-btn { width: 72rpx; font-size: 21rpx; }
.header-btn-hover { transform: scale(.94); background: var(--green-soft); }
.network-glyph { font-size: 24rpx; }

.offline-banner { position: relative; z-index: 4; display: flex; align-items: center; min-height: 70rpx; margin-bottom: 18rpx; padding: 0 22rpx; border: 1rpx solid rgba(214,154,49,.28); border-radius: 24rpx; color: #7b5619; background: rgba(255,241,211,.92); font-size: 24rpx; }
.status-dot { width: 13rpx; height: 13rpx; margin-right: 10rpx; border-radius: 50%; background: #35ad84; box-shadow: 0 0 0 7rpx rgba(53,173,132,.12); }
.status-dot.warning { background: var(--amber); box-shadow: 0 0 0 7rpx rgba(214,154,49,.14); }

.guide-hero { position: relative; z-index: 3; display: flex; min-height: 390rpx; margin-bottom: 20rpx; padding: 36rpx 30rpx; overflow: hidden; border-radius: 42rpx; color: #fff; background: linear-gradient(142deg, #0b5a4c 0%, #137761 55%, #228e77 100%); box-shadow: 0 28rpx 62rpx rgba(13,85,73,.24); }
.guide-hero::before { content: ''; position: absolute; width: 310rpx; height: 310rpx; top: -150rpx; right: -80rpx; border: 1rpx solid rgba(255,255,255,.13); border-radius: 50%; box-shadow: 0 0 0 56rpx rgba(255,255,255,.035), 0 0 0 112rpx rgba(255,255,255,.025); }
.guide-hero::after { content: ''; position: absolute; width: 220rpx; height: 100rpx; left: 0; bottom: 0; opacity: .22; background: radial-gradient(ellipse at bottom left, #9ae5cd, transparent 70%); }
.hero-copy { position: relative; z-index: 3; display: flex; flex: 1; flex-direction: column; justify-content: center; min-width: 0; padding-right: 12rpx; }
.hero-eyebrow { color: #bce9dc; font-size: 21rpx; font-weight: 800; letter-spacing: 2rpx; }
.hero-title { max-width: 390rpx; margin-top: 16rpx; font-size: 43rpx; font-weight: 900; line-height: 1.18; letter-spacing: 1rpx; }
.hero-subtitle { max-width: 390rpx; margin-top: 16rpx; color: rgba(255,255,255,.78); font-size: 23rpx; line-height: 1.65; }
.hero-pills { display: flex; flex-wrap: wrap; margin-top: 22rpx; }
.hero-pill { display: flex; align-items: center; min-height: 48rpx; margin: 0 10rpx 8rpx 0; padding: 0 15rpx; border: 1rpx solid rgba(255,255,255,.18); border-radius: 999rpx; color: rgba(255,255,255,.9); background: rgba(255,255,255,.1); font-size: 20rpx; }
.hero-pill text + text { margin-left: 7rpx; }

.digital-human-wrap { position: relative; z-index: 3; display: flex; width: 218rpx; flex-direction: column; align-items: center; justify-content: flex-end; }
.portrait-halo { position: absolute; width: 205rpx; height: 205rpx; top: 18rpx; border-radius: 50%; background: radial-gradient(circle, rgba(216,255,241,.25), rgba(216,255,241,.04) 58%, transparent 60%); animation: softPulse 3.4s ease-in-out infinite; }
.digital-human-avatar { position: relative; width: 176rpx; height: 244rpx; }
.dh-head { position: absolute; z-index: 4; width: 102rpx; height: 126rpx; top: 37rpx; left: 38rpx; border-radius: 48% 48% 45% 45%; background: linear-gradient(160deg, #f6d9c2, #eabf9f); box-shadow: inset -8rpx -8rpx 18rpx rgba(130,72,48,.08); }
.dh-hair { position: absolute; z-index: 5; width: 116rpx; height: 76rpx; top: 24rpx; left: 31rpx; border-radius: 58rpx 60rpx 24rpx 18rpx; background: linear-gradient(145deg, #183a35, #0e2824); transform: rotate(-4deg); }
.dh-hair::after { content: ''; position: absolute; width: 34rpx; height: 74rpx; top: 42rpx; right: -3rpx; border-radius: 0 22rpx 30rpx 18rpx; background: #12302b; transform: rotate(-7deg); }
.dh-brow, .dh-eye { position: absolute; height: 5rpx; border-radius: 999rpx; background: #35524c; }
.dh-brow { width: 22rpx; top: 49rpx; }
.dh-eye { width: 15rpx; height: 6rpx; top: 65rpx; background: #233b36; }
.dh-brow.left { left: 20rpx; transform: rotate(-5deg); } .dh-brow.right { right: 20rpx; transform: rotate(5deg); }
.dh-eye.left { left: 25rpx; } .dh-eye.right { right: 25rpx; }
.dh-nose { position: absolute; width: 8rpx; height: 14rpx; top: 71rpx; left: 48rpx; border-left: 2rpx solid rgba(115,73,55,.26); border-bottom: 2rpx solid rgba(115,73,55,.18); border-radius: 0 0 0 7rpx; }
.dh-mouth { position: absolute; width: 25rpx; height: 8rpx; top: 96rpx; left: 39rpx; border-bottom: 4rpx solid #a65e55; border-radius: 0 0 50% 50%; transform-origin: top center; }
.dh-neck { position: absolute; z-index: 2; width: 38rpx; height: 44rpx; top: 145rpx; left: 70rpx; border-radius: 12rpx; background: #e9bea0; }
.dh-body { position: absolute; z-index: 3; width: 166rpx; height: 96rpx; left: 6rpx; bottom: 0; overflow: hidden; border-radius: 58rpx 58rpx 18rpx 18rpx; background: linear-gradient(145deg, #f4fbf8, #cce9df); }
.dh-collar { width: 50rpx; height: 34rpx; margin: -4rpx auto 0; border: 8rpx solid #18806a; border-top: 0; border-radius: 0 0 25rpx 25rpx; }
.dh-wave-ring { position: absolute; z-index: 1; width: 178rpx; height: 178rpx; top: 5rpx; left: 0; border: 2rpx solid rgba(183,248,226,.58); border-radius: 50%; animation: portraitWave 2s ease-out infinite; }
.dh-wave-ring.r2 { animation-delay: .5s; }
.dh-nameplate { position: relative; z-index: 5; display: flex; width: 210rpx; min-height: 62rpx; margin-top: -12rpx; padding: 8rpx 12rpx; flex-direction: column; align-items: center; justify-content: center; border: 1rpx solid rgba(255,255,255,.17); border-radius: 20rpx; background: rgba(7,66,55,.64); font-size: 21rpx; font-weight: 800; text-align: center; }
.dh-status { margin-top: 4rpx; color: #bde8dc; font-size: 17rpx; font-weight: 500; }

/* 数字人模式切换按钮 */
.dh-mode-btn { font-size: 20rpx; }
.dh-mode-btn.active { color: #fff; background: var(--green-deep); }

/* 真实模式头像 */
.dh-real-avatar { position: relative; width: 176rpx; display: flex; align-items: center; justify-content: center; }
.dh-real-img { display: block; border-radius: 28rpx; filter: drop-shadow(0 4rpx 12rpx rgba(0,0,0,.08)); }
.dh-real-mouth { position: absolute; left: 80rpx; top: 163rpx; width: 16rpx; height: 5rpx; border-radius: 3rpx; background: #c47a5a; transform-origin: center top; }

.today-strip { position: relative; z-index: 3; display: flex; align-items: center; justify-content: space-between; min-height: 108rpx; margin: 18rpx 0; padding: 20rpx 22rpx 20rpx 26rpx; border: 1rpx solid rgba(214,154,49,.22); border-radius: 30rpx; background: linear-gradient(115deg, rgba(255,249,233,.96), rgba(255,255,255,.92)); box-shadow: 0 14rpx 36rpx rgba(118,84,26,.07); }
.today-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.today-overline { color: #95671d; font-size: 19rpx; font-weight: 800; letter-spacing: 2rpx; }
.today-title { margin-top: 7rpx; overflow: hidden; color: var(--ink); font-size: 28rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.today-action { display: flex; align-items: center; justify-content: center; min-height: 64rpx; margin: 0 0 0 16rpx; padding: 0 20rpx; border: 0; border-radius: 22rpx; color: #fff; background: var(--rust); box-shadow: 0 12rpx 26rpx rgba(184,91,54,.2); font-size: 22rpx; font-weight: 800; }
.today-action text + text { margin-left: 8rpx; }
.button-press { transform: scale(.97); opacity: .9; }

.quick-actions { position: relative; z-index: 3; display: flex; justify-content: space-between; margin-bottom: 20rpx; }
.quick-card { display: flex; width: 23.4%; min-height: 148rpx; margin: 0; padding: 18rpx 8rpx 16rpx; flex-direction: column; align-items: center; justify-content: center; border: 1rpx solid var(--line); border-radius: 28rpx; color: var(--ink); background: rgba(255,255,255,.9); box-shadow: 0 14rpx 36rpx rgba(20,72,63,.07); font-size: 22rpx; font-weight: 800; }
.quick-glyph { display: flex; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; margin-bottom: 13rpx; border-radius: 20rpx; color: #fff; background: var(--green); font-size: 25rpx; font-weight: 900; }
.tone-camera .quick-glyph { background: var(--blue); } .tone-detail .quick-glyph { background: var(--amber); } .tone-services .quick-glyph { background: var(--rust); }
.quick-label { max-width: 120rpx; overflow: hidden; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.quick-card-hover { transform: translateY(-5rpx) scale(.98); box-shadow: 0 18rpx 42rpx rgba(20,72,63,.12); }

.chat-shell { position: relative; z-index: 3; overflow: hidden; border: 1rpx solid var(--line); border-radius: 38rpx; background: rgba(255,255,255,.92); box-shadow: 0 24rpx 58rpx rgba(20,72,63,.09); }
.chat-heading { display: flex; align-items: center; justify-content: space-between; min-height: 112rpx; padding: 22rpx 25rpx; border-bottom: 1rpx solid var(--line); background: linear-gradient(180deg, rgba(250,253,252,.96), rgba(244,250,247,.84)); }
.chat-heading-copy { display: flex; flex-direction: column; }
.chat-eyebrow { color: var(--green); font-size: 17rpx; font-weight: 850; letter-spacing: 2rpx; }
.chat-title { margin-top: 6rpx; font-size: 31rpx; font-weight: 900; }
.chat-status { display: flex; align-items: center; min-height: 48rpx; padding: 0 16rpx; border-radius: 999rpx; color: var(--muted); background: var(--green-soft); font-size: 20rpx; font-weight: 700; }
.chat-status .status-dot { width: 10rpx; height: 10rpx; margin-right: 9rpx; box-shadow: none; }
.chat-list { height: 520rpx; padding: 24rpx 22rpx 12rpx; }
.chat-msg { display: flex; align-items: flex-start; margin-bottom: 20rpx; }
.chat-msg.user { justify-content: flex-end; }
.msg-avatar { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; margin-right: 12rpx; flex-shrink: 0; border-radius: 20rpx; color: #fff; background: linear-gradient(145deg, var(--green), var(--green-deep)); font-size: 22rpx; font-weight: 900; }
.msg-avatar.user-av { margin: 0 0 0 12rpx; color: var(--green-deep); background: var(--green-soft); }
.msg-bubble { max-width: 78%; padding: 18rpx 20rpx; border-radius: 24rpx; font-size: 26rpx; line-height: 1.65; }
.msg-bubble.guide { border: 1rpx solid rgba(29,86,76,.08); border-top-left-radius: 8rpx; color: var(--ink); background: #f5faf8; }
.msg-bubble.user { border-top-right-radius: 8rpx; color: #fff; background: linear-gradient(135deg, var(--green), var(--green-deep)); }
.msg-text { display: block; }
.msg-source { margin-top: 12rpx; padding-top: 10rpx; border-top: 1rpx solid rgba(29,86,76,.1); color: var(--green); font-size: 20rpx; line-height: 1.4; }
.msg-bubble.user .msg-source { border-color: rgba(255,255,255,.18); color: rgba(255,255,255,.72); }
.typing-dots { display: flex; align-items: center; min-height: 22rpx; }
.typing-dots .dot { width: 10rpx; height: 10rpx; margin-right: 8rpx; border-radius: 50%; background: var(--green); animation: dotBounce .8s ease-in-out infinite; }
.typing-dots .dot:nth-child(2) { animation-delay: .12s; } .typing-dots .dot:nth-child(3) { animation-delay: .24s; }

.chat-input-bar { display: flex; align-items: center; min-height: 102rpx; padding: 14rpx 16rpx 16rpx; border-top: 1rpx solid var(--line); background: rgba(247,251,249,.96); }
.chat-tool-btn, .chat-send-btn { display: flex; align-items: center; justify-content: center; width: 66rpx; height: 66rpx; margin: 0; padding: 0; flex-shrink: 0; border: 0; border-radius: 22rpx; font-size: 26rpx; font-weight: 900; }
.chat-tool-btn { margin-right: 8rpx; color: var(--green-deep); background: #fff; border: 1rpx solid var(--line); }
.chat-tool-btn.camera { color: #286f9e; background: var(--blue-soft); }
.chat-input { height: 68rpx; min-width: 0; margin: 0 9rpx 0 1rpx; padding: 0 18rpx; flex: 1; border: 1rpx solid var(--line); border-radius: 22rpx; color: var(--ink); background: #fff; font-size: 24rpx; }
.chat-send-btn { color: #8da39d; background: #e7efec; }
.chat-send-btn.active { color: #fff; background: linear-gradient(145deg, var(--green), var(--green-deep)); box-shadow: 0 10rpx 24rpx rgba(13,85,73,.18); }


.voice-overlay { position: fixed; z-index: 100; display: flex; top: 0; right: 0; bottom: 0; left: 0; align-items: center; justify-content: center; padding: 80rpx 42rpx; background: rgba(5,35,30,.91); }
.voice-overlay::before { content: ''; position: absolute; width: 620rpx; height: 620rpx; border-radius: 50%; background: radial-gradient(circle, rgba(66,195,157,.2), transparent 68%); }
.voice-close { position: absolute; z-index: 3; display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; top: calc(env(safe-area-inset-top) + 28rpx); right: 28rpx; margin: 0; padding: 0; border: 1rpx solid rgba(255,255,255,.16); border-radius: 24rpx; color: #fff; background: rgba(255,255,255,.08); font-size: 34rpx; }
.voice-center { position: relative; z-index: 2; display: flex; width: 100%; flex-direction: column; align-items: center; color: #fff; }
.voice-rings { position: relative; width: 230rpx; height: 230rpx; }
.voice-mic-icon { position: absolute; z-index: 3; display: flex; align-items: center; justify-content: center; width: 112rpx; height: 112rpx; top: 59rpx; left: 59rpx; border-radius: 50%; color: #fff; background: linear-gradient(145deg, #32ad8d, #13715e); box-shadow: 0 20rpx 50rpx rgba(31,174,137,.35); font-size: 42rpx; }
.voice-ring { position: absolute; width: 230rpx; height: 230rpx; top: 0; left: 0; border: 2rpx solid rgba(132,239,208,.5); border-radius: 50%; opacity: .24; }
.voice-ring.active { animation: voiceRing 2.2s ease-out infinite; } .voice-ring.r2.active { animation-delay: .4s; } .voice-ring.r3.active { animation-delay: .8s; }
.voice-label { margin-top: 26rpx; font-size: 34rpx; font-weight: 900; }
.voice-bars { display: flex; align-items: center; height: 58rpx; margin-top: 18rpx; }
.voice-bar { width: 7rpx; height: 12rpx; margin: 0 4rpx; border-radius: 999rpx; background: #8ee5cc; }
.voice-bar.active { animation: barAnim .8s ease-in-out infinite; } .voice-bar:nth-child(2n).active { animation-delay: .1s; } .voice-bar:nth-child(3n).active { animation-delay: .2s; }
.voice-suggestions { display: flex; width: 100%; margin-top: 24rpx; flex-direction: column; align-items: center; }
.voice-sugg-label { margin-bottom: 12rpx; color: rgba(255,255,255,.62); font-size: 22rpx; }
.voice-sugg-chip { width: 100%; min-height: 76rpx; margin: 8rpx 0 0; padding: 0 24rpx; border: 1rpx solid rgba(255,255,255,.13); border-radius: 26rpx; color: rgba(255,255,255,.9); background: rgba(255,255,255,.075); font-size: 24rpx; }
.voice-hint { margin-top: 22rpx; color: rgba(255,255,255,.57); font-size: 22rpx; text-align: center; }

@keyframes portraitWave { 0% { transform: scale(.76); opacity: .65; } 100% { transform: scale(1.35); opacity: 0; } }
@keyframes dotBounce { 0%,100% { transform: translateY(0); opacity: .35; } 50% { transform: translateY(-7rpx); opacity: 1; } }
@keyframes voiceRing { 0% { transform: scale(.72); opacity: .55; } 100% { transform: scale(1.36); opacity: 0; } }
@keyframes barAnim { 0%,100% { height: 14rpx; } 50% { height: 52rpx; } }

@media (max-width: 350px) {
  .guide-page { padding-left: 18rpx; padding-right: 18rpx; }
  .guide-title { max-width: 220rpx; font-size: 28rpx; }
  .guide-header-btn { width: 58rpx; height: 58rpx; margin-left: 5rpx; }
  .guide-header-btn.lang-btn { width: 64rpx; }
  .guide-hero { min-height: 370rpx; padding: 30rpx 22rpx; }
  .hero-title { font-size: 37rpx; }
  .hero-subtitle { font-size: 21rpx; }
  .digital-human-wrap { width: 188rpx; transform: scale(.92); transform-origin: right center; }
}
