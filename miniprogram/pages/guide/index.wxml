<view class="guide-page">
  <!-- Header -->
  <view class="guide-header">
    <text class="guide-title">{{guideTitle}}</text>
    <view class="guide-header-actions">
      <button class="guide-header-btn lang-btn" bindtap="toggleLanguage">
        <text>{{langLabel}}</text>
      </button>
      <button class="guide-header-btn" bindtap="toggleOffline" aria-label="{{toggleOfflineAria}}">
        <text>{{isOffline ? '📡' : '📶'}}</text>
      </button>
      <button class="guide-header-btn" bindtap="openShare" aria-label="{{shareAria}}">
        <text>📤</text>
      </button>
    </view>
  </view>

  <!-- Offline Banner -->
  <view wx:if="{{isOffline}}" class="offline-banner">
    <text>📡 {{guideOffline}}</text>
  </view>

  <!-- LBS Status -->
  <lbs-status spotName="灵山胜境南门" distance="{{320}}" online="{{!isOffline}}" />

  <!-- Digital Human -->
  <view class="digital-human-wrap">
    <view class="digital-human-avatar {{isSpeaking ? 'speaking' : ''}} {{isListening ? 'listening' : ''}}">
      <text class="dh-face">🧑‍🎤</text>
      <view wx:if="{{isSpeaking}}" class="dh-wave-ring">
        <view class="dh-ring r1" />
        <view class="dh-ring r2" />
        <view class="dh-ring r3" />
      </view>
      <view wx:if="{{isListening}}" class="dh-listen-ring">
        <view class="dh-ring r1" />
        <view class="dh-ring r2" />
      </view>
    </view>
    <text class="dh-name">{{guideTitle}}</text>
    <text class="dh-status">{{isSpeaking ? guideSpeaking : isListening ? guideListening : guidePlace}}</text>
  </view>

  <!-- Quick Actions -->
  <view class="quick-actions">
    <button wx:for="{{quickActions}}" wx:key="action" class="quick-chip" bindtap="onQuickAction" data-action="{{item.action}}" data-ask-text="{{item.askText}}">
      <text>{{item.icon}}</text>
      <text>{{item.label}}</text>
    </button>
    <button class="quick-chip camera-chip" bindtap="openCamera">
      <text>📸</text>
      <text>{{guidePhoto}}</text>
    </button>
  </view>

  <!-- Chat Area -->
  <view class="chat-area">
    <scroll-view class="chat-list" scroll-y scroll-into-view="{{scrollToId}}" scroll-with-animation>
      <view wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}" class="chat-msg {{item.role}}">
        <view wx:if="{{item.role === 'guide'}}" class="msg-avatar">🧑‍🎤</view>
        <view class="msg-bubble {{item.role}}">
          <text class="msg-text">{{item.text}}</text>
          <view wx:if="{{item.source}}" class="msg-source">
            <text>📖 {{item.source}}</text>
          </view>
        </view>
        <view wx:if="{{item.role === 'user'}}" class="msg-avatar user-av">👤</view>
      </view>
      <view wx:if="{{isListening}}" class="chat-msg guide">
        <view class="msg-avatar">🧑‍🎤</view>
        <view class="msg-bubble guide typing">
          <view class="typing-dots">
            <view class="dot" />
            <view class="dot" />
            <view class="dot" />
          </view>
        </view>
      </view>
      <view id="msg-bottom" />
    </scroll-view>

    <!-- Input bar -->
    <view class="chat-input-bar safe-bottom">
      <button class="chat-mic-btn" bindtap="openVoice">
        <text>🎤</text>
      </button>
      <input
        class="chat-input"
        placeholder="{{guideInputPlaceholder}}"
        value="{{inputText}}"
        bindinput="onInput"
        bindconfirm="onSend"
        confirm-type="send"
        adjust-position
      />
      <button class="chat-send-btn {{inputText ? 'active' : ''}}" bindtap="onSend" disabled="{{!inputText}}">
        <text>{{guideSend}}</text>
      </button>
    </view>
  </view>

  <!-- Voice Overlay -->
  <view wx:if="{{voiceOpen}}" class="voice-overlay" bindtap="closeVoice">
    <button class="voice-close" bindtap="closeVoice">
      <text>✕</text>
    </button>
    <view class="voice-center" catchtap>
      <view class="voice-rings">
        <view class="voice-ring r1 {{voiceRecording ? 'active' : ''}}" />
        <view class="voice-ring r2 {{voiceRecording ? 'active' : ''}}" />
        <view class="voice-ring r3 {{voiceRecording ? 'active' : ''}}" />
        <view class="voice-mic-icon" bindtap="{{voiceRecording ? 'stopVoiceRecord' : 'startVoiceRecord'}}">🎤</view>
      </view>
      <text class="voice-label">{{voiceRecording ? voiceRecordingLabel : voiceTapStartLabel}}</text>
      <view class="voice-bars">
        <view wx:for="{{16}}" wx:key="*this" wx:for-item="idx" class="voice-bar {{voiceRecording ? 'active' : ''}}" />
      </view>
      <view class="voice-suggestions">
        <text class="voice-hint">{{voiceSuggestionsLabel}}</text>
        <button wx:for="{{voiceSuggestions}}" wx:key="*this" class="voice-chip" bindtap="onVoiceResult" data-text="{{item}}">
          {{item}}
        </button>
      </view>
    </view>
    <text class="voice-bottom-hint">{{voiceRecording ? voiceRecordingHint : voiceIdleHint}}</text>
  </view>
</view>
