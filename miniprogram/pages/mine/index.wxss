.mine-page{min-height:100vh;padding-top:calc(env(safe-area-inset-top) + 20rpx)}.mine-header{padding:18rpx 28rpx}.mine-title{font-size:38rpx;font-weight:900}.mine-hero{display:flex;align-items:center;margin:8rpx 24rpx 18rpx;padding:32rpx;border-radius:40rpx;color:#fff;background:linear-gradient(140deg,#0c5a4c,#16866f 62%,#38a58b);box-shadow:0 24rpx 56rpx rgba(13,85,73,.21)}.mine-avatar{display:flex;align-items:center;justify-content:center;width:112rpx;height:112rpx;margin-right:24rpx;border:1rpx solid rgba(255,255,255,.22);border-radius:38rpx;background:rgba(255,255,255,.14);font-size:40rpx;font-weight:900}.mine-profile{display:flex;min-width:0;flex:1;flex-direction:column}.mine-name{font-size:34rpx;font-weight:900}.mine-subtitle{margin-top:9rpx;color:rgba(255,255,255,.74);font-size:22rpx;line-height:1.5}.mine-stats{display:flex;margin:0 24rpx 18rpx;padding:22rpx 8rpx;border:1rpx solid var(--line);border-radius:32rpx;background:rgba(255,255,255,.93);box-shadow:0 15rpx 38rpx rgba(20,72,63,.06)}.mine-stat{display:flex;flex:1;flex-direction:column;align-items:center;border-right:1rpx solid var(--line)}.mine-stat:last-child{border-right:0}.stat-value{font-size:34rpx;font-weight:900;color:var(--green-deep)}.stat-label{margin-top:5rpx;color:var(--muted);font-size:19rpx}.mine-section{margin:0 24rpx}.mine-section-title{display:block;margin:0 4rpx 13rpx;color:var(--green);font-size:20rpx;font-weight:850;letter-spacing:2rpx}.mine-menu{overflow:hidden;border:1rpx solid var(--line);border-radius:32rpx;background:rgba(255,255,255,.94);box-shadow:0 15rpx 38rpx rgba(20,72,63,.055)}.mine-menu-item{display:flex;align-items:center;width:100%;min-height:98rpx;margin:0;padding:0 22rpx;border:0;border-bottom:1rpx solid var(--line);border-radius:0;color:var(--ink);background:transparent;font-size:25rpx;font-weight:800;text-align:left}.mine-menu-item:last-child{border-bottom:0}.mine-menu-glyph{display:flex;align-items:center;justify-content:center;width:52rpx;height:52rpx;margin-right:16rpx;border-radius:18rpx;color:#fff;background:var(--green);font-size:20rpx;font-weight:900}.mine-menu-item:nth-child(2) .mine-menu-glyph{background:var(--amber)}.mine-menu-item:nth-child(3) .mine-menu-glyph{background:var(--blue)}.mine-menu-item:nth-child(4) .mine-menu-glyph{background:var(--danger)}.mine-arrow{margin-left:auto;color:#91a19d;font-size:25rpx}