.mine-page{min-height:100vh}.mine-hero{display:flex;align-items:center;margin:10rpx 20rpx 18rpx;padding:30rpx;border-radius:38rpx;color:#fff;background:linear-gradient(140deg,#0c5a4c,#16866f 62%,#38a58b);box-shadow:0 22rpx 52rpx rgba(13,85,73,.2)}.mine-avatar{display:flex;align-items:center;justify-content:center;width:104rpx;height:104rpx;margin-right:22rpx;flex-shrink:0;border:1rpx solid rgba(255,255,255,.24);border-radius:35rpx;background:rgba(255,255,255,.15);font-size:38rpx;font-weight:900}.mine-profile{display:flex;min-width:0;flex:1;flex-direction:column}.mine-name{font-size:33rpx;font-weight:900}.mine-subtitle{margin-top:9rpx;color:rgba(255,255,255,.88);font-size:23rpx;line-height:1.5}.mine-stats{display:flex;margin:0 20rpx 20rpx;padding:22rpx 8rpx;border:1rpx solid var(--line);border-radius:31rpx;background:rgba(255,255,255,.95);box-shadow:0 15rpx 38rpx rgba(20,72,63,.06)}.mine-stat{display:flex;flex:1;flex-direction:column;align-items:center;border-right:1rpx solid var(--line)}.mine-stat:last-child{border-right:0}.stat-value{color:var(--green-deep);font-size:33rpx;font-weight:900}.stat-label{margin-top:5rpx;color:#536661;font-size:20rpx}.mine-section{margin:0 20rpx}.mine-section-title{display:block;margin:0 4rpx 13rpx;color:var(--green-deep);font-size:23rpx;font-weight:850}.mine-menu{overflow:hidden;border:1rpx solid var(--line);border-radius:31rpx;background:rgba(255,255,255,.95);box-shadow:0 15rpx 38rpx rgba(20,72,63,.055)}.mine-menu-item{display:flex;align-items:center;width:100%;min-height:96rpx;margin:0;padding:0 22rpx;border:0;border-bottom:1rpx solid var(--line);border-radius:0;color:var(--ink);background:transparent;font-size:25rpx;font-weight:800;text-align:left}.mine-menu-item:last-child{border-bottom:0}.mine-menu-glyph{display:flex;align-items:center;justify-content:center;width:50rpx;height:50rpx;margin-right:16rpx;border-radius:17rpx;color:#fff;background:var(--green);font-size:19rpx;font-weight:900}.mine-menu-item:nth-child(2) .mine-menu-glyph{background:var(--rust)}.mine-menu-item:nth-child(3) .mine-menu-glyph{background:var(--amber)}.mine-menu-item:nth-child(4) .mine-menu-glyph{background:var(--blue)}.mine-menu-item:nth-child(5) .mine-menu-glyph{background:var(--danger)}.mine-arrow{margin-left:auto;color:#82958f;font-size:25rpx}
