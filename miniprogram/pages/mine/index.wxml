<view class="mine-page page has-visitor-nav" animation="{{pageAnimation}}"><view class="mine-header motion-rise"><text class="mine-title">{{title}}</text></view><view class="mine-hero motion-rise-2"><view class="mine-avatar">旅</view><view class="mine-profile"><text class="mine-name">{{welcome}}</text><text class="mine-subtitle">{{subtitle}}</text></view></view><view class="mine-stats motion-rise-2"><view wx:for="{{stats}}" wx:key="label" class="mine-stat"><text class="stat-value">{{item.value}}</text><text class="stat-label">{{item.label}}</text></view></view><view class="mine-section motion-rise-3"><text class="mine-section-title">{{myServices}}</text><view class="mine-menu"><button wx:for="{{services}}" wx:key="key" class="mine-menu-item" bindtap="openItem" data-url="{{item.url}}" data-tab="{{item.tab}}" hover-class="button-press"><view class="mine-menu-glyph">{{item.glyph}}</view><text>{{item.label}}</text><text class="mine-arrow">→</text></button></view></view></view>