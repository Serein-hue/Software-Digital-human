<view class="route-page page has-visitor-nav">
  <view class="header motion-rise">
    <button class="back-btn" bindtap="goBack" hover-class="button-press"><text>←</text></button>
    <view class="route-heading"><text class="title">{{routeTitle}}</text><text class="route-count">{{routeCount}}</text></view>
    <view class="spacer"></view>
  </view>

  <view class="route-hero motion-rise-2">
    <text class="route-hero-eyebrow">精选游览路线</text>
    <text class="route-hero-title">{{routeTitle}}</text>
    <text class="route-hero-copy">{{routeHeroCopy}}</text>
    <view class="route-line-art"><view class="line-dot d1"></view><view class="line-dot d2"></view><view class="line-dot d3"></view></view>
  </view>

  <scroll-view class="pref-bar motion-rise-2" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="pref-inner">
      <button wx:for="{{prefOptions}}" wx:key="key" class="pref-chip {{activePref === item.key ? 'active' : ''}}" bindtap="onPrefTap" data-pref="{{item.key}}">
        <text class="pref-glyph">{{item.glyph}}</text><text>{{item.label}}</text>
      </button>
    </view>
  </scroll-view>

  <view wx:if="{{isLoading}}" class="loading motion-fade">
    <view class="skeleton route-skeleton" wx:for="{{2}}" wx:key="*this"></view>
  </view>

  <view wx:else class="route-list motion-rise-3">
    <view wx:if="{{routes.length === 0}}" class="empty-state card"><view class="empty-glyph">线</view><text>{{emptyLabel}}</text><text class="text-muted">{{refreshLabel}}</text></view>
    <view wx:for="{{routes}}" wx:key="id" class="route-card {{expandedId === item.id ? 'expanded' : ''}}">
      <view class="route-card-main" bindtap="toggleExpand" data-id="{{item.id}}">
        <view class="route-index"><text>0{{index + 1}}</text></view>
        <view class="route-card-content">
          <view class="route-card-heading"><text class="route-title">{{item.title}}</text><text class="route-chevron">{{expandedId === item.id ? '−' : '+'}}</text></view>
          <text class="route-desc">{{item.description}}</text>
          <view class="route-tags"><text wx:for="{{item.tags}}" wx:key="*this" class="route-tag">{{item}}</text></view>
          <view class="route-meta">
            <view><text class="meta-label">{{durationLabel}}</text><text class="meta-value">{{item.duration}}</text></view>
            <view><text class="meta-label">{{distanceLabel}}</text><text class="meta-value">{{item.distance}}</text></view>
            <view><text class="meta-label">{{difficultyLabel}}</text><text class="meta-value">{{item.difficulty}}</text></view>
          </view>
        </view>
      </view>
      <view wx:if="{{expandedId === item.id}}" class="route-detail panel-reveal">
        <view wx:for="{{item.steps}}" wx:key="spot" class="route-step">
          <view class="route-step-axis"><view class="route-step-dot">{{index + 1}}</view><view wx:if="{{index < item.steps.length - 1}}" class="route-step-line"></view></view>
          <view class="route-step-content"><text class="step-spot">{{item.spot}}</text><text class="step-dur">{{item.duration}}</text><text class="step-note">{{item.note}}</text></view>
        </view>
        <button class="route-start-btn btn-primary" bindtap="goBack" hover-class="btn-primary-hover"><text>{{startNav}}</text><text>→</text></button>
      </view>
    </view>
  </view>
</view>
