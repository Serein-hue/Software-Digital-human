.route-page { min-height: 100vh; background: var(--paper); }

.route-header {
  display: flex; align-items: center; gap: 20rpx;
  padding: 28rpx; background: var(--teal);
}
.route-back-btn {
  width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center;
  background: rgba(255,255,255,0.15); border-radius: 50%;
  color: #fff; font-size: 24rpx; border: none; padding: 0;
}
.route-header-title { color: #fff; font-size: 36rpx; font-weight: 800; display: block; }
.route-header-sub { color: rgba(255,255,255,0.6); font-size: 24rpx; }

.pref-bar { white-space:nowrap; padding:20rpx 24rpx; }
.pref-chip { display:inline-flex; align-items:center; gap:6rpx; padding:14rpx 24rpx; margin-right:16rpx; background:#fff; border:1rpx solid var(--line); border-radius:24rpx; font-size:26rpx; color:var(--ink); }
.pref-chip.active { background:var(--teal); color:#fff; border-color:var(--teal); }
.loading { padding:24rpx; }

.route-list { padding: 24rpx; display: flex; flex-direction: column; gap: 20rpx; }

.route-card {
  background: #fff; border: 1rpx solid var(--line); border-radius: 20rpx;
  overflow: hidden; transition: border-color 0.2s;
}
.route-card.expanded { border-color: var(--teal); }

.route-card-main { padding: 24rpx; }
.route-card-top { display: flex; justify-content: space-between; gap: 16rpx; margin-bottom: 14rpx; }
.route-card-left { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.route-title { font-size: 30rpx; font-weight: 700; color: var(--ink); }
.route-desc { font-size: 24rpx; color: var(--muted); line-height: 1.5; }
.route-tags { display: flex; gap: 8rpx; }
.route-tag {
  padding: 4rpx 14rpx; border-radius: 12rpx;
  background: rgba(21,93,88,0.06); color: var(--teal);
  font-size: 22rpx; font-weight: 600;
}
.route-chevron { font-size: 24rpx; color: var(--muted); transition: transform 0.2s; }
.route-chevron.open { transform: rotate(180deg); }
.route-meta { display: flex; gap: 24rpx; font-size: 24rpx; color: var(--muted); }
.route-diff { color: var(--teal); font-weight: 600; }

.route-detail { border-top: 1rpx solid var(--line); padding: 24rpx; }
.route-steps { display: flex; flex-direction: column; gap: 16rpx; }
.route-step { display: flex; gap: 16rpx; }
.route-step-dot {
  display: flex; flex-direction: column; align-items: center; width: 40rpx;
}
.route-step-dot > text {
  width: 36rpx; height: 36rpx; display: flex; align-items: center; justify-content: center;
  background: var(--teal); color: #fff; border-radius: 50%; font-size: 22rpx; font-weight: 700;
}
.route-step-line {
  flex: 1; width: 2rpx; min-height: 28rpx; background: var(--line);
  margin: 4rpx 0;
}
.route-step-content { flex: 1; padding-bottom: 8rpx; }
.step-spot { display: block; font-size: 28rpx; font-weight: 700; color: var(--ink); margin-bottom: 4rpx; }
.step-dur { display: block; font-size: 22rpx; color: var(--teal); margin-bottom: 2rpx; }
.step-note { display: block; font-size: 24rpx; color: var(--muted); }

.route-start-btn {
  display: flex; align-items: center; justify-content: center;
  margin-top: 20rpx; padding: 20rpx;
  background: var(--teal); color: #fff; border-radius: 16rpx;
  font-size: 28rpx; font-weight: 700; border: none;
}
