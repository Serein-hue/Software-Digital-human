.page { min-height:100vh; background:var(--paper); padding-bottom:safe-bottom; }
.header { display:flex; align-items:center; padding:24rpx 32rpx; gap:16rpx; }
.back-btn { width:64rpx; height:64rpx; display:flex; align-items:center; justify-content:center; background:#fff; border:1rpx solid var(--line); border-radius:16rpx; font-size:28rpx; }
.title { font-size:36rpx; font-weight:700; color:var(--ink); }
.spacer { flex:1; }

.section { padding:24rpx 32rpx; }
.section-title { font-size:28rpx; font-weight:700; color:var(--ink); margin-bottom:16rpx; display:block; }

.product-list { display:flex; flex-direction:column; gap:16rpx; }
.product-card { display:flex; align-items:center; gap:20rpx; background:#fff; border:1rpx solid var(--line); border-radius:20rpx; padding:24rpx; }
.prod-icon { font-size:40rpx; }
.prod-body { flex:1; display:flex; flex-direction:column; gap:4rpx; }
.prod-name { font-size:28rpx; font-weight:600; color:var(--ink); }
.prod-status { font-size:22rpx; }
.prod-status.on { color:var(--teal); }
.prod-status.off { color:var(--muted); }
.prod-price { text-align:right; }
.price-num { font-size:36rpx; font-weight:800; color:var(--rust); display:block; }
.price-label { font-size:20rpx; color:var(--muted); }

.verify-box { display:flex; gap:12rpx; margin-bottom:20rpx; }
.verify-input { flex:1; padding:20rpx 24rpx; background:#fff; border:2rpx solid var(--line); border-radius:16rpx; font-size:28rpx; }
.verify-btn { padding:20rpx 32rpx; background:var(--teal); color:#fff; border-radius:16rpx; font-size:28rpx; font-weight:600; border:none; }

.verify-result { padding:24rpx; border-radius:20rpx; display:flex; flex-direction:column; gap:12rpx; }
.verify-result.success { background:rgba(21,93,88,0.06); border:1rpx solid var(--teal); }
.verify-result.fail { background:rgba(180,82,44,0.06); border:1rpx solid var(--rust); }
.vr-icon { font-size:40rpx; }
.vr-status { font-size:30rpx; font-weight:700; }
.vr-names { display:flex; flex-wrap:wrap; gap:8rpx; }
.vr-names text { padding:6rpx 16rpx; background:#fff; border-radius:12rpx; font-size:24rpx; color:var(--ink); }
.vr-disclaimer { font-size:22rpx; color:var(--muted); }

.disclaimer { padding:32rpx; text-align:center; font-size:22rpx; color:var(--muted); }
