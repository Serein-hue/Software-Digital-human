.page{min-height:100vh;padding-bottom:calc(44rpx + env(safe-area-inset-bottom));}.header{background:transparent;border:0;}.section{padding:12rpx 24rpx 20rpx;}.section-title{display:block;margin:8rpx 0 16rpx;color:var(--green);font-size:20rpx;font-weight:850;letter-spacing:2rpx;}.product-list{display:flex;flex-direction:column;}.product-card{display:flex;align-items:center;min-height:120rpx;margin-bottom:15rpx;padding:18rpx 20rpx;border:1rpx solid var(--line);border-radius:31rpx;background:rgba(255,255,255,.93);box-shadow:0 15rpx 38rpx rgba(20,72,63,.06);}.prod-icon{display:flex;align-items:center;justify-content:center;width:70rpx;height:70rpx;margin-right:17rpx;border-radius:23rpx;color:#fff;background:var(--rust);font-size:24rpx;font-weight:900;}.prod-body{display:flex;min-width:0;flex:1;flex-direction:column;}.prod-name{font-size:27rpx;font-weight:900;}.prod-status{margin-top:5rpx;font-size:20rpx;font-weight:750;}.prod-status.on{color:var(--green);}.prod-status.off{color:var(--muted);}.prod-price{text-align:right;}.price-num{display:block;color:var(--rust);font-size:35rpx;font-weight:900;}.price-label{color:var(--muted);font-size:18rpx;}.verify-box{display:flex;margin-bottom:18rpx;padding:12rpx;border:1rpx solid var(--line);border-radius:30rpx;background:#fff;box-shadow:0 15rpx 38rpx rgba(20,72,63,.055);}.verify-input{height:72rpx;min-width:0;padding:0 16rpx;flex:1;border:0;font-size:25rpx;}.verify-btn{min-width:132rpx;margin:0;padding:0 22rpx;border:0;border-radius:22rpx;color:#fff;background:var(--green-deep);font-size:24rpx;font-weight:850;}.verify-result{display:flex;padding:22rpx;border:1rpx solid var(--line);border-radius:28rpx;flex-direction:column;background:#fff;}.verify-result.success{border-color:rgba(22,134,111,.3);background:var(--green-soft);}.verify-result.fail{border-color:rgba(184,91,54,.24);background:var(--rust-soft);}.vr-icon{font-size:34rpx;font-weight:900;}.vr-status{margin-top:7rpx;font-size:27rpx;font-weight:900;}.vr-names{display:flex;flex-wrap:wrap;margin-top:8rpx;}.vr-names text{margin:0 8rpx 8rpx 0;padding:6rpx 14rpx;border-radius:12rpx;background:#fff;font-size:22rpx;}.vr-disclaimer{margin-top:9rpx;color:var(--muted);font-size:21rpx;line-height:1.55;}.disclaimer{margin:0 24rpx;padding:20rpx;border-radius:24rpx;color:#8c621d;background:var(--amber-soft);font-size:21rpx;line-height:1.55;text-align:center;}