.ticket-guide{display:flex;align-items:center;margin:10rpx 24rpx 20rpx;padding:24rpx 24rpx;border:1rpx solid rgba(22,134,111,.18);border-radius:30rpx;background:linear-gradient(135deg,rgba(223,244,237,.96),rgba(255,255,255,.94))}.ticket-guide>view{display:flex;min-width:0;flex:1;flex-direction:column}.ticket-guide-title{color:var(--green-deep);font-size:28rpx;font-weight:900}.ticket-guide-copy{margin-top:7rpx;color:var(--muted);font-size:21rpx;line-height:1.45}.entrance-btn{display:flex;align-items:center;justify-content:center;min-width:124rpx;min-height:66rpx;margin:0 0 0 16rpx;padding:0 18rpx;border:0;border-radius:22rpx;color:#fff;background:var(--green-deep);font-size:22rpx;font-weight:850}.section{padding:8rpx 24rpx 20rpx}.section-title{display:block;margin:8rpx 2rpx 16rpx;color:var(--green-deep);font-size:23rpx;font-weight:850}.product-skeleton{height:120rpx;margin-bottom:15rpx}.product-list{display:flex;flex-direction:column}.product-card{display:flex;align-items:center;min-height:120rpx;margin-bottom:15rpx;padding:18rpx 22rpx;border:1rpx solid var(--line);border-radius:31rpx;background:rgba(255,255,255,.95);box-shadow:0 15rpx 38rpx rgba(20,72,63,.06)}.prod-icon{display:flex;align-items:center;justify-content:center;width:68rpx;height:68rpx;margin-right:16rpx;flex-shrink:0;border-radius:23rpx;color:#fff;background:var(--rust);font-size:23rpx;font-weight:900}.prod-body{display:flex;min-width:0;flex:1;flex-direction:column}.prod-name{font-size:27rpx;font-weight:900}.prod-status{margin-top:5rpx;font-size:20rpx;font-weight:750}.prod-status.on{color:var(--green)}.prod-status.off{color:var(--muted)}.prod-price{min-width:116rpx;padding-left:12rpx;text-align:right}.price-num{display:block;color:var(--rust);font-size:33rpx;font-weight:900}.price-label{color:var(--muted);font-size:18rpx}.verify-section{padding-bottom:18rpx}.verify-box{display:flex;margin-bottom:14rpx;padding:10rpx;border:1rpx solid var(--line);border-radius:28rpx;background:#fff;box-shadow:0 13rpx 34rpx rgba(20,72,63,.05)}.verify-input{height:72rpx;min-width:0;padding:0 16rpx;flex:1;border:0;font-size:24rpx}.scan-btn{display:flex;align-items:center;justify-content:center;min-width:104rpx;margin:0;padding:0 18rpx;border:0;border-radius:20rpx;color:var(--green-deep);background:var(--green-soft);font-size:23rpx;font-weight:850}.verify-btn{display:flex;width:100%;min-height:78rpx;margin:0;padding:0 24rpx;align-items:center;justify-content:center;border:0;border-radius:24rpx;color:#fff;background:var(--green-deep);font-size:25rpx;font-weight:850}.verify-btn[disabled]{opacity:.65}.verify-result{display:flex;margin-top:16rpx;padding:22rpx;border:1rpx solid var(--line);border-radius:28rpx;flex-direction:column;background:#fff}.verify-result.success{border-color:rgba(22,134,111,.3);background:var(--green-soft)}.verify-result.fail{border-color:rgba(184,91,54,.24);background:var(--rust-soft)}.vr-icon{font-size:34rpx;font-weight:900}.vr-status{margin-top:7rpx;font-size:27rpx;font-weight:900}.vr-names{display:flex;flex-wrap:wrap;margin-top:8rpx}.vr-names text{margin:0 8rpx 8rpx 0;padding:6rpx 14rpx;border-radius:12rpx;background:#fff;font-size:22rpx}.vr-disclaimer{margin-top:9rpx;color:var(--muted);font-size:21rpx;line-height:1.55}.disclaimer{margin:0 24rpx;padding:20rpx;border-radius:24rpx;color:#76521b;background:var(--amber-soft);font-size:21rpx;line-height:1.55;text-align:center}
