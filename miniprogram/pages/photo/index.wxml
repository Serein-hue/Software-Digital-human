<view class="photo-page">
  <view class="photo-header">
    <button class="photo-back-btn" bindtap="goBack"><text>◀</text></button>
    <text class="photo-title">{{pageTitle}}</text>
    <text class="photo-hint">{{pageHint}}</text>
  </view>

  <!-- Viewfinder / Photo Preview -->
  <view class="photo-viewfinder">
    <image wx:if="{{photoPath}}" class="photo-preview" src="{{photoPath}}" mode="aspectFill" />
    <view wx:else class="photo-grid" />
    <view class="photo-corner tl" /><view class="photo-corner tr" />
    <view class="photo-corner bl" /><view class="photo-corner br" />
    <view wx:if="{{phase === 'scanning'}}" class="photo-scan-beam" />
  </view>

  <!-- Idle: just show capture button -->
  <view wx:if="{{phase === 'idle'}}" class="photo-prompt">
    <view class="prompt-icon"><text>识</text></view>
    <text class="prompt-text">{{promptLabel}}</text>
  </view>

  <!-- Captured: ask what they saw -->
  <view wx:if="{{phase === 'captured'}}" class="photo-question-area">
    <text class="question-label">{{questionLabel}}</text>
    <view class="question-input-row">
      <input class="question-input" placeholder="{{questionPlaceholder}}" value="{{question}}" bindinput="onQuestionInput" bindconfirm="onSubmitQuestion" confirm-type="search" />
      <button class="question-submit" bindtap="onSubmitQuestion">{{identifyLabel}}</button>
    </view>
    <text class="question-hint">{{quickSelectLabel}}</text>
    <view class="quick-spots">
      <button wx:for="{{quickSpots}}" wx:key="*this" class="quick-spot-chip" bindtap="onQuickSpot" data-name="{{item}}">{{item}}</button>
    </view>
    <button class="photo-retake-btn" bindtap="retakePhoto">{{retakeLabel}}</button>
  </view>

  <!-- Scanning state -->
  <view wx:if="{{phase === 'scanning'}}" class="photo-status">
    <text class="photo-status-label">{{scanningLabel}}</text>
    <view class="photo-progress">
      <view class="photo-progress-fill" style="width: {{progress}}%;" />
    </view>
    <text class="photo-status-hint">{{scanningHint}}</text>
  </view>

  <!-- Results from RAG -->
  <view wx:if="{{phase === 'results'}}" class="photo-results">
    <view class="photo-results-head">
      <text>{{resultsLabel}}</text>
      <button class="photo-rescan-btn" bindtap="startScan">{{rescanLabel}}</button>
    </view>
    <view wx:for="{{results}}" wx:key="id" class="photo-result-card">
      <view class="photo-result-rank"><text>{{index + 1}}</text></view>
      <view class="photo-result-info">
        <view class="photo-result-top">
          <text class="result-name">{{item.name}}</text>
          <text class="result-cat">{{item.category}}</text>
        </view>
        <text class="result-desc">{{item.description}}</text>
        <text class="result-confidence">{{confidenceLabel}} {{item.confidence}}%</text>
      </view>
      <view class="photo-result-actions">
        <button wx:if="{{item.spotId}}" class="photo-action-btn" bindtap="openDetail" data-id="{{item.spotId}}">
          <text>详</text>
        </button>
        <button class="photo-action-btn ask" bindtap="askAbout" data-name="{{item.name}}">
          <text>{{askLabel}} →</text>
        </button>
      </view>
    </view>
  </view>

  <!-- Bottom actions -->
  <view class="photo-bottom-actions safe-bottom">
    <button wx:if="{{phase !== 'scanning' && phase !== 'captured'}}" class="photo-capture-btn" bindtap="takePhoto">
      <text>{{captureLabel}}</text>
    </button>
  </view>
</view>
