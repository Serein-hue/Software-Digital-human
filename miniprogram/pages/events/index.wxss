.page{min-height:100vh;padding-bottom:calc(44rpx + env(safe-area-inset-bottom));}.header{background:transparent;border:0;}.loading,.list{padding:12rpx 24rpx 24rpx;}.section-label{display:block;margin:8rpx 0 18rpx;color:var(--green);font-size:19rpx;font-weight:850;letter-spacing:3rpx;text-transform:uppercase;}.event-card{display:flex;align-items:center;min-height:132rpx;margin-bottom:16rpx;padding:20rpx;border:1rpx solid var(--line);border-radius:32rpx;background:rgba(255,255,255,.93);box-shadow:0 16rpx 40rpx rgba(20,72,63,.065);}.ev-icon{display:flex;align-items:center;justify-content:center;width:78rpx;height:78rpx;margin-right:18rpx;flex-shrink:0;border-radius:26rpx;color:#fff;background:linear-gradient(145deg,var(--amber),#b47719);font-size:25rpx;font-weight:900;}.event-card:nth-child(2n) .ev-icon{background:linear-gradient(145deg,var(--blue),#296c97);}.ev-body{display:flex;min-width:0;flex:1;flex-direction:column;}.ev-name{font-size:28rpx;font-weight:900;}.ev-time{display:flex;align-items:center;margin-top:7rpx;color:var(--green);font-size:23rpx;font-weight:800;}.ev-clock{margin-right:9rpx;padding:4rpx 9rpx;border-radius:999rpx;color:#8b611a;background:var(--amber-soft);font-size:17rpx;}.ev-desc{margin-top:7rpx;color:var(--muted);font-size:22rpx;line-height:1.5;}.empty-event{display:flex;align-items:center;justify-content:center;width:88rpx;height:88rpx;border-radius:30rpx;color:#fff;background:var(--amber);font-size:30rpx;font-weight:900;}