.events-intro{margin:10rpx 24rpx 20rpx;padding:24rpx 26rpx;border:1rpx solid rgba(22,134,111,.18);border-radius:30rpx;background:linear-gradient(135deg,rgba(223,244,237,.96),rgba(255,255,255,.94))}.events-intro-title{display:block;color:var(--green-deep);font-size:28rpx;font-weight:900}.events-intro-copy{display:block;margin-top:8rpx;color:var(--muted);font-size:22rpx;line-height:1.5}.loading,.list{padding:0 24rpx 24rpx}.event-skeleton{height:264rpx;margin-bottom:16rpx}.section-label{display:block;margin:8rpx 2rpx 16rpx;color:var(--green-deep);font-size:23rpx;font-weight:850}.event-card{display:flex;margin-bottom:18rpx;padding:24rpx;border:1rpx solid var(--line);border-radius:32rpx;flex-direction:column;background:rgba(255,255,255,.95);box-shadow:0 16rpx 40rpx rgba(20,72,63,.065)}.event-head{display:flex;align-items:center}.ev-icon{display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;margin-right:16rpx;flex-shrink:0;border-radius:24rpx;color:#fff;background:linear-gradient(145deg,var(--amber),#b47719);font-size:23rpx;font-weight:900}.event-card:nth-child(2n) .ev-icon{background:linear-gradient(145deg,var(--blue),#296c97)}.ev-heading{display:flex;min-width:0;flex:1;flex-direction:column}.ev-name{font-size:29rpx;font-weight:900}.ev-time{display:flex;align-items:center;margin-top:7rpx;color:var(--green-deep);font-size:23rpx;font-weight:800}.ev-clock{margin-right:9rpx;padding:4rpx 10rpx;border-radius:999rpx;color:#8b611a;background:var(--amber-soft);font-size:18rpx}.ev-location{display:flex;align-items:center;margin-top:18rpx;color:var(--ink);font-size:23rpx;font-weight:780}.location-dot{width:10rpx;height:10rpx;margin-right:10rpx;border-radius:50%;background:var(--green);box-shadow:0 0 0 6rpx var(--green-soft)}.ev-desc{margin-top:10rpx;color:var(--muted);font-size:23rpx;line-height:1.55}.event-actions{display:flex;gap:14rpx;margin-top:20rpx}.event-actions button{display:flex;min-height:70rpx;margin:0;padding:0 24rpx;flex:1;align-items:center;justify-content:center;border-radius:22rpx;font-size:23rpx;font-weight:850}.detail-btn{border:1rpx solid var(--line-strong);color:var(--green-deep);background:#fff}.map-btn{border:0;color:#fff;background:var(--green-deep)}.event-action-press{transform:scale(.97);opacity:.88}.empty-event{display:flex;align-items:center;justify-content:center;width:88rpx;height:88rpx;border-radius:30rpx;color:#fff;background:var(--amber);font-size:30rpx;font-weight:900}
