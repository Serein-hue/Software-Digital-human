<view class="page has-visitor-nav">
  <view class="header">
    <button class="back-btn" bindtap="goBack"><text>←</text></button>
    <text class="title">{{title}}</text>
    <view class="spacer" />
  </view>

  <view wx:if="{{isLoading}}" class="loading">
    <view class="skeleton" style="height:160rpx;margin-bottom:24rpx;" wx:for="{{3}}" wx:key="*this" />
  </view>

  <view wx:else class="list">
    <view class="section-label">{{daily}}</view>
    <view wx:if="{{events.length === 0}}" class="empty-state">
      <view class="empty-event">演</view>
      <text>{{emptyLabel}}</text>
    </view>
    <view wx:for="{{events}}" wx:key="id" class="event-card">
      <view class="ev-icon">{{item.icon}}</view>
      <view class="ev-body">
        <text class="ev-name">{{item.name}}</text>
        <view class="ev-time">
          <text class="ev-clock">{{nextLabel}}</text>
          <text>{{item.time}}</text>
        </view>
        <text wx:if="{{item.description}}" class="ev-desc">{{item.description}}</text>
      </view>
    </view>
  </view>
  <visitor-nav active="services" />
</view>
