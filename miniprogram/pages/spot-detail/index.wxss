.sd-page{min-height:100vh;padding-bottom:calc(44rpx + env(safe-area-inset-bottom));background:var(--paper);}.sd-hero{position:relative;min-height:390rpx;padding:calc(env(safe-area-inset-top) + 24rpx) 28rpx 84rpx;overflow:hidden;border-radius:0 0 48rpx 48rpx;box-shadow:0 25rpx 58rpx rgba(13,85,73,.2);}.sd-hero::after{content:'';position:absolute;width:420rpx;height:420rpx;top:-220rpx;right:-160rpx;border:1rpx solid rgba(255,255,255,.13);border-radius:50%;box-shadow:0 0 0 60rpx rgba(255,255,255,.035),0 0 0 120rpx rgba(255,255,255,.025);}.sd-back-btn{position:relative;z-index:3;display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;margin:0 0 66rpx;padding:0;border:1rpx solid rgba(255,255,255,.2);border-radius:25rpx;color:#fff;background:rgba(255,255,255,.12);font-size:32rpx;font-weight:800;}.sd-hero-overlay{position:relative;z-index:2;display:flex;flex-direction:column;}.sd-category{align-self:flex-start;padding:8rpx 18rpx;border:1rpx solid rgba(255,255,255,.16);border-radius:999rpx;color:rgba(255,255,255,.85);background:rgba(255,255,255,.1);font-size:20rpx;font-weight:750;}.sd-name{margin-top:16rpx;color:#fff;font-size:48rpx;font-weight:900;line-height:1.2;}.sd-hero-wave{display:none;}.sd-tiers{display:flex;margin:22rpx 24rpx;padding:8rpx;border:1rpx solid var(--line);border-radius:28rpx;background:rgba(255,255,255,.9);box-shadow:0 14rpx 36rpx rgba(20,72,63,.06);}.sd-tier-btn{flex:1;min-height:70rpx;margin:0;padding:0 8rpx;border:0;border-radius:22rpx;color:var(--muted);background:transparent;font-size:22rpx;font-weight:750;}.sd-tier-btn.active{color:#fff;background:linear-gradient(135deg,var(--green),var(--green-deep));box-shadow:0 10rpx 22rpx rgba(13,85,73,.16);}.sd-content{margin:0 24rpx 18rpx;padding:27rpx;border:1rpx solid var(--line);border-radius:34rpx;background:rgba(255,255,255,.93);box-shadow:0 16rpx 42rpx rgba(20,72,63,.06);}.sd-tags{display:flex;flex-wrap:wrap;margin-bottom:13rpx;}.sd-tag{margin:0 8rpx 8rpx 0;padding:6rpx 14rpx;border-radius:999rpx;color:var(--green-deep);background:var(--green-soft);font-size:20rpx;font-weight:750;}.sd-location{display:block;margin-bottom:17rpx;padding:13rpx 16rpx;border-radius:19rpx;color:var(--green-deep);background:var(--paper);font-size:23rpx;font-weight:750;}.sd-para{display:block;margin-bottom:17rpx;color:var(--ink);font-size:27rpx;line-height:1.82;}.sd-source{display:flex;margin-top:8rpx;padding:15rpx 17rpx;border-left:6rpx solid var(--green);border-radius:5rpx 18rpx 18rpx 5rpx;color:var(--muted);background:var(--green-soft);font-size:21rpx;line-height:1.5;}.sd-audio{display:flex;align-items:center;margin:0 24rpx 20rpx;padding:18rpx 20rpx;border:1rpx solid var(--line);border-radius:31rpx;background:#fff;box-shadow:0 15rpx 38rpx rgba(20,72,63,.06);}.sd-play-btn{display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;margin:0 17rpx 0 0;padding:0;border:0;border-radius:24rpx;color:#fff;background:var(--green);font-size:25rpx;font-weight:900;}.sd-play-btn.playing{background:var(--rust);}.sd-audio-info{display:flex;flex-direction:column;}.sd-audio-label{font-size:25rpx;font-weight:850;}.sd-audio-dur{margin-top:4rpx;color:var(--muted);font-size:20rpx;}.sd-related{padding:0 24rpx 32rpx;}.sd-related-head{margin:26rpx 3rpx 14rpx;color:var(--green);font-size:21rpx;font-weight:850;letter-spacing:2rpx;}.sd-related-chip{display:flex;width:100%;min-height:104rpx;margin-bottom:13rpx;padding:17rpx;align-items:center;border:1rpx solid var(--line);border-radius:29rpx;background:rgba(255,255,255,.93);text-align:left;box-shadow:0 13rpx 34rpx rgba(20,72,63,.05);}.nearby-mark{display:flex;align-items:center;justify-content:center;width:58rpx;height:58rpx;margin-right:14rpx;flex-shrink:0;border-radius:19rpx;color:#fff;background:var(--blue);font-size:20rpx;font-weight:900;}.sd-related-text{display:flex;min-width:0;flex:1;flex-direction:column;}.sd-related-name{font-size:25rpx;font-weight:850;}.sd-related-desc{max-width:510rpx;margin-top:5rpx;overflow:hidden;color:var(--muted);font-size:20rpx;text-overflow:ellipsis;white-space:nowrap;}
