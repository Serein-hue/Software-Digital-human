.services-page{min-height:100vh}.services-hero{display:flex;align-items:center;min-height:196rpx;margin:10rpx 24rpx 22rpx;padding:28rpx;border-radius:36rpx;color:#fff;background:linear-gradient(138deg,#0c5a4c,#16866f 64%,#38a58b);box-shadow:0 22rpx 52rpx rgba(13,85,73,.2)}
.services-hero-mark{display:flex;align-items:center;justify-content:center;width:104rpx;height:104rpx;margin-right:24rpx;flex-shrink:0;border:1rpx solid rgba(255,255,255,.2);border-radius:34rpx;background:rgba(255,255,255,.11)}
.map-pin{position:relative;width:44rpx;height:54rpx;border:7rpx solid #fff;border-radius:50% 50% 50% 0;transform:rotate(-45deg)}.map-pin view{position:absolute;width:12rpx;height:12rpx;top:14rpx;left:10rpx;border-radius:50%;background:#fff}
.services-hero-copy{display:flex;min-width:0;flex:1;flex-direction:column}.services-title{font-size:35rpx;font-weight:900}.services-desc{margin-top:9rpx;color:rgba(255,255,255,.8);font-size:23rpx;line-height:1.5}.services-map-hint{margin-top:12rpx;color:#d5f5ec;font-size:20rpx;font-weight:750}
.service-shortcuts{margin:0 24rpx 22rpx}.shortcuts-title{display:block;margin:0 4rpx 13rpx;color:var(--green-deep);font-size:23rpx;font-weight:850}.shortcuts-grid{display:flex;gap:14rpx}.shortcut-card{display:flex;min-width:0;min-height:92rpx;margin:0;padding:14rpx;flex:1;align-items:center;border:1rpx solid var(--line);border-radius:26rpx;color:var(--ink);background:rgba(255,255,255,.94);box-shadow:0 12rpx 30rpx rgba(20,72,63,.05);font-size:23rpx;font-weight:850}.shortcut-glyph{display:flex;align-items:center;justify-content:center;width:42rpx;height:42rpx;margin-right:10rpx;flex-shrink:0;border-radius:14rpx;color:#fff;background:var(--green);font-size:18rpx;font-weight:900}.shortcut-card:nth-child(2) .shortcut-glyph{background:var(--rust)}.shortcut-card:nth-child(3) .shortcut-glyph{background:var(--blue)}.shortcut-press{transform:scale(.97);opacity:.9}
.cat-tabs{width:100%;margin-bottom:18rpx;white-space:nowrap}.cat-inner{display:flex;padding:0 24rpx 6rpx}.cat-chip{display:inline-flex;align-items:center;min-height:66rpx;margin-right:12rpx;padding:0 24rpx;border:1rpx solid var(--line);border-radius:24rpx;color:var(--muted);background:rgba(255,255,255,.92);font-size:23rpx;font-weight:760}.cat-chip.active{color:#fff;border-color:var(--green-deep);background:var(--green-deep);box-shadow:0 10rpx 24rpx rgba(13,85,73,.14)}
.loading,.service-list{padding:0 24rpx}.service-skeleton{height:132rpx;margin-bottom:16rpx}.empty-service{display:flex;align-items:center;justify-content:center;width:88rpx;height:88rpx;border-radius:30rpx;color:#fff;background:var(--green);font-size:30rpx;font-weight:900}
.service-card{display:flex;align-items:center;min-height:132rpx;margin-bottom:16rpx;padding:20rpx;border:1rpx solid var(--line);border-radius:31rpx;background:rgba(255,255,255,.94);box-shadow:0 15rpx 38rpx rgba(20,72,63,.06)}.service-icon{display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;margin-right:16rpx;flex-shrink:0;border-radius:24rpx;font-size:24rpx;font-weight:900}.service-copy{display:flex;min-width:0;flex:1;flex-direction:column}.service-title-row{display:flex;min-width:0;align-items:center}.svc-name{min-width:0;overflow:hidden;color:var(--ink);font-size:27rpx;font-weight:900;text-overflow:ellipsis;white-space:nowrap}.service-category{margin-left:10rpx;flex-shrink:0;font-size:18rpx;font-weight:800}.svc-location{display:flex;min-width:0;align-items:center;margin-top:9rpx;color:var(--muted);font-size:21rpx}.svc-location text{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.mini-pin{width:9rpx;height:9rpx;margin-right:8rpx;flex-shrink:0;border-radius:50%;background:var(--green);box-shadow:0 0 0 5rpx var(--green-soft)}
.navigate-btn{display:flex;align-items:center;justify-content:center;min-width:100rpx;min-height:66rpx;margin:0 0 0 14rpx;padding:0 20rpx;border:0;border-radius:22rpx;color:#fff;background:var(--green-deep);font-size:23rpx;font-weight:850}.navigate-btn-press{transform:scale(.95);opacity:.88}
