.services-page{min-height:100vh;padding-bottom:calc(44rpx + env(safe-area-inset-bottom));}.header{background:transparent;border:0;}.services-hero{display:flex;align-items:center;min-height:230rpx;margin:8rpx 24rpx 22rpx;padding:30rpx;border-radius:40rpx;color:#fff;background:linear-gradient(138deg,#0c5a4c,#16866f 62%,#38a58b);box-shadow:0 24rpx 56rpx rgba(13,85,73,.21);}.services-hero-mark{display:flex;align-items:center;justify-content:center;width:132rpx;height:132rpx;margin-right:26rpx;flex-shrink:0;border:1rpx solid rgba(255,255,255,.17);border-radius:43rpx;background:rgba(255,255,255,.1);}.map-pin{position:relative;width:54rpx;height:67rpx;border:8rpx solid #fff;border-radius:50% 50% 50% 0;transform:rotate(-45deg);}.map-pin view{position:absolute;width:14rpx;height:14rpx;top:18rpx;left:13rpx;border-radius:50%;background:#fff;}.services-hero-copy{display:flex;min-width:0;flex:1;flex-direction:column;}.services-eyebrow{color:#bce9dc;font-size:17rpx;font-weight:850;letter-spacing:3rpx;}.services-title{margin-top:12rpx;font-size:38rpx;font-weight:900;}.services-desc{margin-top:11rpx;color:rgba(255,255,255,.76);font-size:22rpx;line-height:1.55;}.cat-tabs{width:100%;margin-bottom:20rpx;white-space:nowrap;}.cat-inner{display:flex;padding:0 24rpx 6rpx;}.cat-chip{display:inline-flex;align-items:center;min-height:70rpx;margin-right:12rpx;padding:0 20rpx 0 11rpx;border:1rpx solid var(--line);border-radius:25rpx;color:var(--muted);background:rgba(255,255,255,.9);font-size:23rpx;font-weight:750;}.cat-chip.active{color:#fff;border-color:var(--green);background:var(--green-deep);box-shadow:0 12rpx 26rpx rgba(13,85,73,.16);}.cat-icon{display:flex;align-items:center;justify-content:center;min-width:43rpx;height:43rpx;margin-right:9rpx;padding:0 7rpx;border-radius:14rpx;color:var(--green-deep);background:var(--green-soft);font-size:17rpx;font-weight:900;}.cat-chip.active .cat-icon{color:#fff;background:rgba(255,255,255,.14);}.loading,.service-list{padding:0 24rpx;}.service-skeleton{height:126rpx;margin-bottom:16rpx;}.empty-service{display:flex;align-items:center;justify-content:center;width:88rpx;height:88rpx;border-radius:30rpx;color:#fff;background:var(--green);font-size:30rpx;font-weight:900;}.service-card{display:flex;align-items:center;min-height:126rpx;margin-bottom:16rpx;padding:18rpx 18rpx;border:1rpx solid var(--line);border-radius:31rpx;background:rgba(255,255,255,.92);box-shadow:0 15rpx 38rpx rgba(20,72,63,.065);}.service-icon{display:flex;align-items:center;justify-content:center;width:76rpx;height:76rpx;margin-right:17rpx;flex-shrink:0;border-radius:25rpx;font-size:25rpx;font-weight:900;}.service-copy{display:flex;min-width:0;flex:1;flex-direction:column;}.svc-name{overflow:hidden;color:var(--ink);font-size:27rpx;font-weight:900;text-overflow:ellipsis;white-space:nowrap;}.svc-location{display:flex;align-items:center;margin-top:8rpx;color:var(--muted);font-size:21rpx;}.mini-pin{width:10rpx;height:10rpx;margin-right:8rpx;border-radius:50%;background:var(--green);box-shadow:0 0 0 5rpx var(--green-soft);}.service-side{display:flex;margin-left:12rpx;flex-direction:column;align-items:flex-end;}.service-category{font-size:19rpx;font-weight:800;}.service-arrow{margin-top:10rpx;color:#8da09a;font-size:26rpx;}.spacer{width:72rpx;}

.service-shortcuts{margin:0 24rpx 20rpx}.shortcuts-title{display:block;margin:0 4rpx 13rpx;color:var(--green);font-size:20rpx;font-weight:850;letter-spacing:2rpx}.shortcuts-grid{display:flex;justify-content:space-between}.shortcut-card{position:relative;display:flex;width:31.8%;min-height:112rpx;margin:0;padding:14rpx 10rpx;flex-direction:column;align-items:flex-start;justify-content:center;border:1rpx solid var(--line);border-radius:27rpx;color:var(--ink);background:rgba(255,255,255,.93);box-shadow:0 14rpx 34rpx rgba(20,72,63,.055);font-size:22rpx;font-weight:850}.shortcut-glyph{display:flex;align-items:center;justify-content:center;width:43rpx;height:43rpx;margin-bottom:9rpx;border-radius:14rpx;color:#fff;background:var(--green);font-size:19rpx;font-weight:900}.shortcut-card:nth-child(2) .shortcut-glyph{background:var(--rust)}.shortcut-card:nth-child(3) .shortcut-glyph{background:var(--blue)}.shortcut-arrow{position:absolute;right:12rpx;bottom:11rpx;color:#91a19d;font-size:22rpx}.shortcut-press{transform:scale(.97);opacity:.9}
