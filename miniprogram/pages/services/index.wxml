<view class="page">
  <view class="header">
    <button class="back-btn" bindtap="goBack">
      <text>←</text>
    </button>
    <text class="title">{{title}}</text>
    <view class="spacer" />
  </view>

  <!-- Category tabs -->
  <scroll-view class="cat-tabs" scroll-x>
    <button
      wx:for="{{categories}}"
      wx:key="key"
      class="cat-chip {{activeCategory === item.key ? 'active' : ''}}"
      bindtap="onCategoryTap"
      data-category="{{item.key}}"
    >
      <text>{{item.icon}} {{item.label}}</text>
    </button>
  </scroll-view>

  <!-- Loading -->
  <view wx:if="{{isLoading}}" class="loading">
    <view class="skeleton" style="height:120rpx;margin-bottom:24rpx;" wx:for="{{3}}" wx:key="*this" />
  </view>

  <!-- Service list -->
  <view wx:else class="list">
    <view wx:if="{{services.length === 0}}" class="empty-state">
      <text style="font-size:48rpx;">📍</text>
      <text>暂无服务设施信息</text>
    </view>
    <view wx:for="{{services}}" wx:key="id" class="service-card">
      <view class="card-left" style="background:{{item.color}}15;">
        <text style="font-size:40rpx;">{{item.icon}}</text>
      </view>
      <view class="card-body">
        <text class="svc-name">{{item.name}}</text>
        <text class="svc-loc">📍 {{item.location}}</text>
      </view>
      <view class="card-right">
        <text style="color:{{item.color}};font-size:22rpx;font-weight:600;">{{item.category}}</text>
      </view>
    </view>
  </view>
</view>
