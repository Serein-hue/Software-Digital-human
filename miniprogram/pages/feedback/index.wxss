.page{min-height:100vh;padding-bottom:calc(44rpx + env(safe-area-inset-bottom));}.header{background:transparent;border:0;}.form{display:flex;padding:14rpx 24rpx;flex-direction:column;}.rating-section,.toggle-row,.comment-section{margin-bottom:17rpx;padding:23rpx;border:1rpx solid var(--line);border-radius:31rpx;background:rgba(255,255,255,.93);box-shadow:0 15rpx 38rpx rgba(20,72,63,.055);}.section-label{display:block;margin-bottom:14rpx;color:var(--green);font-size:20rpx;font-weight:850;letter-spacing:1rpx;}.stars-row{display:flex;justify-content:space-between;}.star{color:#b8c6c2;font-size:54rpx;opacity:.45;}.star.on{color:var(--amber);opacity:1;transform:scale(1.04);}.toggle-row{display:flex;align-items:center;justify-content:space-between;}.toggle-label{font-size:26rpx;font-weight:800;}.toggle-switch{position:relative;width:92rpx;height:52rpx;border-radius:999rpx;background:#dbe5e2;transition:background .2s;}.toggle-switch.on{background:var(--green);}.toggle-knob{position:absolute;width:42rpx;height:42rpx;top:5rpx;left:5rpx;border-radius:50%;background:#fff;box-shadow:0 4rpx 12rpx rgba(20,72,63,.16);transition:transform .2s;}.toggle-switch.on .toggle-knob{transform:translateX(40rpx);}.comment-input{width:100%;min-height:210rpx;padding:18rpx;border:1rpx solid var(--line);border-radius:23rpx;background:var(--paper-light);font-size:25rpx;line-height:1.6;}.submit-btn{min-height:92rpx;margin-top:5rpx;border:0;border-radius:29rpx;color:#fff;background:linear-gradient(135deg,var(--green),var(--green-deep));box-shadow:0 19rpx 38rpx rgba(13,85,73,.2);font-size:29rpx;font-weight:900;}.done-box{display:flex;padding:110rpx 40rpx;flex-direction:column;align-items:center;text-align:center;}.done-icon{display:flex;align-items:center;justify-content:center;width:116rpx;height:116rpx;border-radius:38rpx;color:#fff;background:var(--green);box-shadow:0 20rpx 42rpx rgba(22,134,111,.2);font-size:50rpx;font-weight:900;}.done-text{margin-top:24rpx;font-size:31rpx;font-weight:900;}.reset-btn{min-height:82rpx;margin-top:26rpx;padding:0 38rpx;border:1rpx solid var(--line);border-radius:27rpx;color:var(--green-deep);background:#fff;font-size:25rpx;font-weight:850;}