page {
  --green: #16866f;
  --green-deep: #0d5549;
  --green-soft: #dff4ed;
  --teal: var(--green);
  --teal-dark: var(--green-deep);
  --teal-light: #35ad84;
  --blue: #3b82b9;
  --blue-soft: #e4f2fb;
  --amber: #d69a31;
  --amber-soft: #fff1d3;
  --rust: #b85b36;
  --rust-soft: #fae8df;
  --danger: #c4463d;
  --danger-soft: #fff0ed;
  --paper: #eff8f5;
  --paper-deep: #e3f1ec;
  --paper-light: #f8fcfa;
  --surface: #ffffff;
  --ink: #142421;
  --muted: #60706c;
  --line: rgba(29, 86, 76, 0.13);
  --line-strong: rgba(29, 86, 76, 0.23);
  min-height: 100%;
  color: var(--ink);
  background: var(--paper);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "HarmonyOS Sans SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

view, text, button, input, textarea, image, scroll-view { box-sizing: border-box; }
button::after { border: 0; }
button { line-height: 1.25; }

.flex-row { display: flex; align-items: center; }
.flex-col { display: flex; flex-direction: column; }
.flex-1 { flex: 1; }
.gap-8 { gap: 8rpx; }
.gap-12 { gap: 12rpx; }
.gap-16 { gap: 16rpx; }
.text-muted { color: var(--muted); font-size: 24rpx; }
.text-green, .text-teal { color: var(--green); }

.page {
  position: relative;
  min-height: 100vh;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  background:
    radial-gradient(circle at 8% 4%, rgba(22, 134, 111, 0.11), transparent 34%),
    radial-gradient(circle at 94% 14%, rgba(59, 130, 185, 0.09), transparent 30%),
    linear-gradient(180deg, #f7fbfa 0%, var(--paper) 100%);
}

.page::before {
  content: '';
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: .32;
  background-image:
    linear-gradient(rgba(20, 91, 78, .03) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(20, 91, 78, .03) 1rpx, transparent 1rpx);
  background-size: 64rpx 64rpx;
}

.header {
  position: relative;
  z-index: 4;
  display: grid;
  grid-template-columns: 80rpx minmax(0, 1fr) 80rpx;
  align-items: center;
  min-height: 112rpx;
  padding: max(20rpx, env(safe-area-inset-top)) 28rpx 16rpx;
  background: rgba(255,255,255,.82);
  border-bottom: 1rpx solid rgba(29,86,76,.08);
}

.back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid var(--line);
  border-radius: 26rpx;
  color: var(--ink);
  background: rgba(255,255,255,.92);
  font-size: 34rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 24rpx rgba(20,72,63,.06);
}

.title {
  min-width: 0;
  padding: 0 12rpx;
  color: var(--ink);
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.25;
  text-align: center;
  letter-spacing: -1rpx;
}

.spacer { width: 72rpx; }

.card {
  position: relative;
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  padding: 28rpx;
  background: rgba(255,255,255,.9);
  box-shadow: 0 18rpx 52rpx rgba(20,72,63,.07);
}

.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 88rpx;
  padding: 0 36rpx;
  border: 0;
  border-radius: 28rpx;
  color: #fff;
  background: linear-gradient(135deg, var(--green), var(--green-deep));
  box-shadow: 0 18rpx 36rpx rgba(13,85,73,.2);
  font-size: 28rpx;
  font-weight: 800;
}

.btn-primary-hover { transform: scale(.985); opacity: .92; }

.btn-outline {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 84rpx;
  padding: 0 32rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 28rpx;
  color: var(--green-deep);
  background: rgba(255,255,255,.88);
  font-size: 27rpx;
  font-weight: 750;
}

.tag, .badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  width: auto;
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: var(--green-deep);
  background: var(--green-soft);
  font-size: 22rpx;
  font-weight: 750;
}

.badge-rust { color: #93482c; background: var(--rust-soft); }
.badge-blue { color: #286f9e; background: var(--blue-soft); }
.badge-amber { color: #8d6117; background: var(--amber-soft); }

.skeleton {
  border-radius: 18rpx;
  background: linear-gradient(90deg, #edf5f2 25%, #dfece7 50%, #edf5f2 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite linear;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 96rpx 36rpx;
  color: var(--muted);
  text-align: center;
}

.empty-state image { width: 112rpx; height: 112rpx; opacity: .45; }
.safe-bottom { padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); }

.motion-rise { animation: motionRise 560ms cubic-bezier(.16,1,.3,1) both; }
.motion-rise-2 { animation: motionRise 620ms cubic-bezier(.16,1,.3,1) 70ms both; }
.motion-rise-3 { animation: motionRise 680ms cubic-bezier(.16,1,.3,1) 140ms both; }
.motion-rise-4 { animation: motionRise 720ms cubic-bezier(.16,1,.3,1) 210ms both; }
.motion-fade { animation: motionFade 360ms ease both; }

@keyframes motionRise {
  from { opacity: 0; transform: translate3d(0, 24rpx, 0) scale(.988); }
  to { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
}

@keyframes motionFade { from { opacity: 0; } to { opacity: 1; } }
@keyframes shimmer { to { background-position: -200% 0; } }
@keyframes softPulse { 0%,100% { opacity: .5; transform: scale(1); } 50% { opacity: 1; transform: scale(1.08); } }
@keyframes floatY { 0%,100% { transform: translate3d(0,0,0); } 50% { transform: translate3d(0,-12rpx,0); } }
